{
  "dependencies": {
    "@monorepo/shared": "^0.1.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^3.0.0"
  },
  "name": "backend",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:push": "sh scripts/prisma.sh db push --schema ../database/prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "sh scripts/prisma.sh generate --schema ../database/prisma/schema.prisma",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "type": "module",
  "version": "0.1.0"
}
