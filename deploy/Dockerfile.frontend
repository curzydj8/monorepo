# =============================================================================
# Dockerfile.frontend — 前端静态站点镜像（多阶段）
# 阶段1：node:20-alpine 构建 Vite 产物
# 阶段2：nginx:alpine 托管静态文件 + 反向代理 /api
# 构建上下文：仓库根目录（docker compose 已配置 context: ..）
# 约定契约：
#   - frontend workspace 名为 "frontend"，构建脚本为 `npm run build --workspace=frontend`
#   - 构建产物为 frontend/dist/（Vite 默认）
#   - API 基地址通过构建参数 VITE_API_URL 注入（默认 /api，走同域 nginx 代理）
# =============================================================================

# ---- 构建阶段 ----
FROM node:20-alpine AS builder

ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

WORKDIR /app

# 先拷贝 workspace 清单，利用 Docker 层缓存
COPY package.json ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/

RUN npm install --workspace=frontend --workspace=shared --include-workspace-root \
    --no-audit --no-fund

# 再拷贝源码
COPY shared/ ./shared/
COPY frontend/ ./frontend/

# 构建：先 shared（frontend 依赖它的 dist 与类型），再 frontend
RUN npm run build --workspace=@monorepo/shared \
 && npm run build --workspace=frontend

# ---- 运行阶段 ----
FROM nginx:alpine

# 构建产物 -> nginx 静态根目录
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
# 反向代理与 SPA fallback 配置
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
